rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function canEdit() {
      return isAuthenticated() && getUserRole() in ['admin', 'secretaria'];
    }

    // Roles allowed to create/update clinical documents (admin, secretaria, medico).
    // Medico can author clinical documents but cannot edit patient records,
    // therapies or surgeries, nor delete anything.
    function canDocument() {
      return isAuthenticated() && getUserRole() in ['admin', 'secretaria', 'medico'];
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // Patients
    match /patients/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if canEdit();
    }

    // Clinical documents (subcollection of each patient)
    match /patients/{patientId}/documents/{documentId} {
      allow read:             if isAuthenticated();
      allow create, update:   if canDocument();
      allow delete:           if isAdmin();
    }

    // Therapies
    match /therapies/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if canEdit();
    }

    // Therapists directory
    match /therapists/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Users (roles)
    match /users/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Any other collection
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if canEdit();
    }
  }
}
