rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // Las reglas de Storage NO pueden leer Firestore, por lo que el rol solo puede
    // comprobarse mediante custom claims en el token (request.auth.token.role).
    //
    // Enforcement PROGRESIVO para no romper producción durante la migración:
    //   - Si el usuario aún NO tiene el claim `role` → se permite (igual que hoy).
    //   - Si YA tiene el claim → se exige un rol con permiso de edición.
    // Una vez asignados los claims a todos los usuarios (ver SECURITY.md), debe
    // eliminarse la rama `lacksRoleClaim()` para enforcement estricto.
    function lacksRoleClaim() {
      return !('role' in request.auth.token);
    }

    function canWriteFiles() {
      return isAuthenticated() &&
             (lacksRoleClaim() || request.auth.token.role in ['admin', 'secretaria', 'medico']);
    }

    function isValidFileType() {
      return request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('image/jpeg')      ||
             request.resource.contentType.matches('image/png')       ||
             request.resource.contentType.matches('image/webp');
    }

    function isUnderSizeLimit() {
      // 10 MB
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // ── Patient clinical files ────────────────────────────────────────────────
    // Estructura: patients/{patientId}/{category}/{filename}
    match /patients/{patientId}/{category}/{filename} {
      // Cualquier usuario autenticado puede leer (descargar) archivos clínicos.
      allow read: if isAuthenticated();

      // Subir / reemplazar: rol con permiso + tipo válido + dentro del límite.
      allow create, update: if canWriteFiles()
                            && isValidFileType()
                            && isUnderSizeLimit();

      // Borrar: rol con permiso de edición.
      allow delete: if canWriteFiles();
    }

    // ── Denegar todo lo demás ────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
