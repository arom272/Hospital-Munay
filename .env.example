# Configuración de Firebase (proyecto web)
# Copia este archivo como .env y rellena con los valores de tu proyecto:
# Firebase Console → Configuración del proyecto → Tus apps → SDK setup and configuration
#
# Nota: estas claves VITE_* se exponen en el bundle del cliente (es normal en
# apps web de Firebase). La seguridad real se aplica en firestore.rules y
# storage.rules, no ocultando estas claves.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
